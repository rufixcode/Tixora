APP_NAME=Tixora
APP_ENV=production
APP_DEBUG=false
# Paste your existing backend APP_KEY; never rotate it on redeploy.
APP_KEY=
APP_URL=https://YOUR_BACKEND_SERVICE.onrender.com
ASSET_URL=https://YOUR_BACKEND_SERVICE.onrender.com
PORT=10000
DB_CONNECTION=mysql
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=YOUR_AIVEN_PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=https://tixora-mobile.vercel.app
MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
ASSISTANT_ENABLED=false
# Hosted AI: enable after adding your private Groq API key in Render.
ASSISTANT_URL=https://api.groq.com/openai/v1/chat/completions
ASSISTANT_MODEL=openai/gpt-oss-20b
ASSISTANT_API_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Use the eventual website URL, not the API service URL.
PAYMONGO_RETURN_URL=https://tixora-self.vercel.app/bookings
PAYMONGO_PAYMENT_METHODS=card
