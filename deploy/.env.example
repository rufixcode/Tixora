# Copy to deploy/.env on the server only; never commit real values.
APP_URL=https://tickets.example.edu
# Generate 32 random bytes on the server (openssl rand -base64 32); prefix the result with base64:
APP_KEY=
DB_DATABASE=tixora
DB_USERNAME=tixora
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Leave loopback-only behind the host's HTTPS reverse proxy.
HTTP_PORT=8080
